PORT=3000
BOT_TOKEN=change-me-to-a-long-random-string

# 저장소: Upstash Redis (Vercel Marketplace에서 연동하면 KV_REST_API_URL/TOKEN 이름으로 자동 주입됨)
# 비워 두면 메모리에 저장 → 로컬 테스트용 (재시작하면 사라짐, Vercel에서는 동작하지 않음)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# !ai 명령용 (서버 환경변수에만 보관, 폰 스크립트/저장소에 넣지 마세요)
OPENAI_API_KEY=
# OpenAI에서 만든 저장된 에이전트 ID (agent_...). 모델/지침/도구는 에이전트 설정을 따름
# API 키에 api.agents.read, api.agents.write, api.responses.write 권한이 필요
OPENAI_AGENT_ID=
AI_COOLDOWN_SEC=5
